# 1. Add sensitive files to .gitignore
cat >> .gitignore <<'EOF'

# Secrets
.env
.env.*
**/.env
**/.env.*
**/env
serviceAccountKey.json
**/serviceAccountKey.json

# This file currently contains Facebook token
fb.js

# Dependencies / generated files
node_modules/
**/node_modules/
core
core.*
*.log
screensho.png
sector_temp/
EOF











